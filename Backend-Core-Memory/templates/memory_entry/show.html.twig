{% extends 'base.html.twig' %}

{% block title %}MemoryEntry{% endblock %}

{% block body %}
    <h1>MemoryEntry</h1>

    <table class="table">
        <tbody>
            <tr>
                <th>Id</th>
                <td>{{ memory_entry.id }}</td>
            </tr>
            <tr>
                <th>Title</th>
                <td>{{ memory_entry.title }}</td>
            </tr>
            <tr>
                <th>Description</th>
                <td>{{ memory_entry.description }}</td>
            </tr>
            <tr>
                <th>Image</th>
                <td>{{ memory_entry.image }}</td>
            </tr>
            <tr>
                <th>Date_start</th>
                <td>{{ memory_entry.dateStart ? memory_entry.dateStart|date('Y-m-d') : '' }}</td>
            </tr>
            <tr>
                <th>Date_end</th>
                <td>{{ memory_entry.dateEnd ? memory_entry.dateEnd|date('Y-m-d') : '' }}</td>
            </tr>
            <tr>
                <th>Created_at</th>
                <td>{{ memory_entry.createdAt ? memory_entry.createdAt|date('Y-m-d H:i:s') : '' }}</td>
            </tr>
            <tr>
                <th>Updated_at</th>
                <td>{{ memory_entry.updatedAt ? memory_entry.updatedAt|date('Y-m-d H:i:s') : '' }}</td>
            </tr>
            <tr>
                <th>Color</th>
                <td>{{ memory_entry.color }}</td>
            </tr>
        </tbody>
    </table>

    <a href="{{ path('app_memory_entry_index') }}">back to list</a>

    <a href="{{ path('app_memory_entry_edit', {'id': memory_entry.id}) }}">edit</a>

    {{ include('memory_entry/_delete_form.html.twig') }}
{% endblock %}

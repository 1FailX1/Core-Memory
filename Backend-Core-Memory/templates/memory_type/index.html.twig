{% extends 'base.html.twig' %}

{% block title %}MemoryType index
{% endblock %}

{% block body %}
	<h1>MemoryType index</h1>

	<table class="table">
		<thead>
			<tr>
				<th>Id</th>
				<th>Type</th>
				<th>Color</th>
				<th>actions</th>
			</tr>
		</thead>
		<tbody>
			{% for memory_type in memory_types %}
				<tr>
					<td>{{ memory_type.id }}</td>
					<td>{{ memory_type.type }}</td>
					<td>
						{% if memory_type.color %}
							<span style="display:inline-block;width:0.75rem;height:0.75rem;border-radius:999px;background-color:{{ memory_type.color }};margin-right:0.5rem;"></span>
							{{ memory_type.color }}
						{% endif %}
					</td>
					<td>
						<a href="{{ path('app_memory_type_show', {'id': memory_type.id}) }}">show</a>
						<a href="{{ path('app_memory_type_edit', {'id': memory_type.id}) }}">edit</a>
					</td>
				</tr>
			{% else %}
				<tr>
					<td colspan="4">no records found</td>
				</tr>
			{% endfor %}
		</tbody>
	</table>

	<a href="{{ path('app_memory_type_new') }}">Create new</a>
{% endblock %}
